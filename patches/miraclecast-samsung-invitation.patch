+static void supplicant_event_p2p_invitation_received(struct supplicant *s,
+						     struct wpas_message *ev)
+{
+	struct supplicant_peer *sp;
+	const char *mac;
+	int r;
+
+	r = wpas_message_dict_read(ev, "sa", 's', &mac);
+	if (r < 0) {
+		log_debug("no sa in P2P-INVITATION-RECEIVED: %s",
+			  wpas_message_get_raw(ev));
+		return;
+	}
+
+	sp = find_peer_by_p2p_mac(s, mac);
+	if (!sp) {
+		log_debug("stale P2P-INVITATION-RECEIVED: %s",
+			  wpas_message_get_raw(ev));
+		return;
+	}
+
+	log_info("P2P invitation from %s — P2P_CONNECT pbc join", mac);
+	{
+		_wpas_message_unref_ struct wpas_message *m = NULL;
+		int cr;
+		cr = wpas_message_new_request(sp->s->bus_global, "P2P_CONNECT", &m);
+		if (cr >= 0)
+			cr = wpas_message_append(m, "sss", sp->p->p2p_mac, "pbc", "join");
+		if (cr >= 0)
+			cr = wpas_call_async(sp->s->bus_global, m, NULL, NULL, 0, NULL);
+		if (cr < 0)
+			log_warning("invitation join failed: %d", cr);
+		else
+			sp->s->pending = sp;
+	}
+}
